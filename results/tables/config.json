{
  "data": {
    "co2_csv": "data/raw/owid_co2/owid-co2-data.csv",
    "energy_csv": "data/raw/owid_energy/owid-energy-data.csv",
    "processed_npz": "data/processed/panel.npz",
    "meta_json": "data/processed/panel_meta.json",
